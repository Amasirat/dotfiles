# Increase volume
"wpctl set-sink-volume @DEFAULT_SINK@ +1000"
   XF86AudioRaiseVolume

# Decrease volume
"wpctl set-sink-volume @DEFAULT_SINK@ -1000"
   XF86AudioLowerVolume

# Mute volume
"wpctl set-sink-mute @DEFAULT_SINK@ toggle"
   XF86AudioMute

# Mute microphone
"wpctl set-source-mute @DEFAULT_SOURCE@ toggle"
   XF86AudioMicMute

# Brightness Up
"brightnessctl --class=backlight set +10%"
    XF86MonBrightnessUp
# Brightness Down
"brightnessctl --class=backlight set 10%-"
    XF86MonBrightnessDown
